{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    {
      "name": "KiriCattus",
      "contact": {
        "homepage": "https://tophatcat.dev",
        "github": "https://github.com/KiriCattus",
        "bsky": "https://bsky.app/profile/tophatcat.dev",
        "curseforge": "https://www.curseforge.com/members/KiriCattus",
        "modrinth": "https://modrinth.com/user/KiriCattus"
      }
    }
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "LGPL-2.1",
  "icon": "icon.png",
  "entrypoints": {
    "main": [
      "dev.tophatcat.mysteriouslands.MysteriousFabric"
    ],
    "client": [
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_url}"
      },
      "update_checker": true
    },
    "mc-publish": {
      "curseforge": "${curseforge_id}",
      "modrinth": "${modrinth_id}",
      "loaders": [
        "fabric"
      ],
      "dependencies": [
        "fabric-api(required){curseforge:306612}{modrinth:P7dR8mSH}",
        "sparkweave(required){curseforge:911456}{modrinth:nf68xfAw}",
        "resourcefulconfig(required){curseforge:714059}{modrinth:M1953qlQ}"
      ]
    }
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "java": ">=${java_version}",
    "minecraft": "=${minecraft_version}",
    "fabric-api": ">=${fabric_api_version}",
    "sparkweave": "*",
    "resourcefulconfig": "*"
  },
  "environment": "*",
  "accessWidener": "mysteriouslands.accesswidener"
}
